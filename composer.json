{
    "name": "semiconductor/web",
    "description": "The Streaming/HTTP transport for Superconductor MCP.",
    "type": "library",
    "version": "0.10.0",
    "keywords": [
        "superconductor",
        "semiconductor",
        "mcp",
        "sse",
        "transport"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "superconductor/mcp": "^0.10.0",
        "venusian-voyager/io-pools": "^0.10.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "venusian-voyager/config": "^0.10.0"
    },
    "autoload": {
        "psr-4": {
            "SuperconductorMCP\\SSE\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SuperconductorMCP\\SSE\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "extra": {
        "venusian": {
            "providers": [
                "SuperconductorMCP\\SSE\\Providers\\SSEServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
