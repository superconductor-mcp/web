{
    "name": "superconductor/web",
    "description": "The Streaming/HTTP transport for Superconductor MCP.",
    "type": "library",
    "version": "0.11.0",
    "keywords": [
        "superconductor",
        "mcp",
        "streamable-http",
        "sse",
        "transport"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "~8.4.27||^8.5.12",
        "superconductor/core": "^0.11.0",
        "venusian-mariner/http": "^0.11.0",
        "venusian-mariner/nuts-and-bolts": "^0.11.0",
        "venusian-mariner/routing": "^0.11.0",
        "venusian-voyager/contracts": "^0.11.0",
        "venusian-voyager/nuts-and-bolts": "^0.11.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "venusian/framework": "^0.11.0",
        "venusian/serve": "^0.11.0"
    },
    "autoload": {
        "psr-4": {
            "SuperconductorMCP\\SSE\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SuperconductorMCP\\SSE\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "extra": {
        "venusian": {
            "providers": [
                "SuperconductorMCP\\SSE\\Providers\\SSEServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
